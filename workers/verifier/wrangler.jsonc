{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sayso-verifier",
  "account_id": "ea0d54352cf9d80e962154980504b428",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "sayso.seams.sh",
      "custom_domain": true
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": ["**/*.wasm"],
      "fallthrough": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ACCOUNT_VOICE",
        "class_name": "AccountVoiceDO"
      },
      {
        "name": "SPEAKER_CONTAINER",
        "class_name": "SpeakerContainer"
      }
    ]
  },
  "containers": [
    {
      "class_name": "SpeakerContainer",
      "image": "../../crates/speaker-service/Dockerfile",
      "max_instances": 4,
      "instance_type": "standard-1"
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "AccountVoiceDO",
        "SpeakerContainer"
      ]
    }
  ],
  "vars": {
    "SAYSO_ALLOWED_ORIGIN": "*"
  },
  "env": {
    // The verifier of the Seams lane staging-testnet: its own verdict key, templates and
    // container. It has no public route, so no browser reaches it and CORS does not apply. The
    // lane's Gateway calls it through a service binding with `Authorization: Bearer
    // SAYSO_API_KEY`; with no SAYSO_ENROLL_SECRET, no browser token works. Its secrets:
    // VERDICT_SECRET_KEY_HEX and SAYSO_API_KEY.
    "staging-testnet": {
      "workers_dev": false,
      "preview_urls": false,
      "routes": [],
      "ai": {
        "binding": "AI"
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "ACCOUNT_VOICE",
            "class_name": "AccountVoiceDO"
          },
          {
            "name": "SPEAKER_CONTAINER",
            "class_name": "SpeakerContainer"
          }
        ]
      },
      "containers": [
        {
          "class_name": "SpeakerContainer",
          "image": "../../crates/speaker-service/Dockerfile",
          "max_instances": 4,
          "instance_type": "standard-1"
        }
      ],
      "vars": {}
    }
  }
}
