{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sayso-verifier",
  "account_id": "ea0d54352cf9d80e962154980504b428",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-01",
  "ai": {
    "binding": "AI"
  },
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": ["**/*.wasm"],
      "fallthrough": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ACCOUNT_VOICE",
        "class_name": "AccountVoiceDO"
      },
      {
        "name": "SPEAKER_CONTAINER",
        "class_name": "SpeakerContainer"
      }
    ]
  },
  "containers": [
    {
      "class_name": "SpeakerContainer",
      "image": "../../crates/speaker-service/Dockerfile",
      "max_instances": 4,
      "instance_type": "standard-1"
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "AccountVoiceDO",
        "SpeakerContainer"
      ]
    }
  ],
  "vars": {
    "SAYSO_ALLOWED_ORIGIN": "*"
  }
}
