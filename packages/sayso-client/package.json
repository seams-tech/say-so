{
  "name": "@seams/sayso-client",
  "version": "0.2.0",
  "type": "module",
  "description": "SaySo streaming WebSocket & HTTP client SDK with AudioWorklet PCM capture and local Ed25519 verdict verification.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seams-tech/say-so.git",
    "directory": "packages/sayso-client"
  },
  "homepage": "https://github.com/seams-tech/say-so/tree/main/packages/sayso-client#readme",
  "bugs": {
    "url": "https://github.com/seams-tech/say-so/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "type-check": "tsc --noEmit",
    "test": "node --test tests/*.test.ts"
  },
  "dependencies": {
    "@seams/sayso-verdict": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.2.0",
    "typescript": "^5.9.3"
  }
}
